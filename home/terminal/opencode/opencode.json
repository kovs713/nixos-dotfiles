{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugins": [
    "@mohak34/opencode-notifier@latest",
    "@dietrichgebert/ponytail",
    "opencode-todolist",
    "@madsoftwaredev/opencode-direnv"
  ],
  "mcp": {
    "excalidraw": {
      "type": "local",
      "command": ["npx", "-y", "mcp-excalidraw-server"],
      "enabled": false
    }
  },
  "default_agent": "plan",
  "permission": "allow",
  "agent": {
    "chat": {
      "mode": "primary",
      "description": "Shrunk chat - conversation + skills, minimal prompt",
      "prompt": "{file:~/.config/opencode/prompts/chat.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "todowrite": "deny",
        "lsp": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "description": "Coding agent - shell + edits, shrunk prompt",
      "prompt": "{file:~/.config/opencode/prompts/coding.txt}",
      "permission": "allow"
    },
    "plan": {
      "mode": "primary",
      "description": "Plan - same as build but planning only",
      "prompt": "{file:~/.config/opencode/prompts/plan.txt}",
      "permission": "allow"
    },
    "teach": {
      "mode": "primary",
      "description": "Adaptive tutor — diagnose understanding, derive ideas, check transfer, practice",
      "prompt": "{file:~/.config/opencode/agent/teach.md}",
      "permission": "allow"
    }
  }
}
